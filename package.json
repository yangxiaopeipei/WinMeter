{
  "name": "winmeter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib",
    "build": "tauri build --bundles nsis -- --locked",
    "release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  },
  "description": "Windows 系统资源监控工具",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
